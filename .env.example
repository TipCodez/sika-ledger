# Copy to .env. All external integrations start disabled.
DATABASE_URL=sqlite:///./sika.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
DEMO_MODE=true
# Gemini is called only by the backend. Never put this key in a browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Only test keys are accepted by this prototype. Live payments are blocked.
PAYSTACK_SECRET_KEY=
# Used only for test checkout, where the provider requires an email.
PAYSTACK_TEST_EMAIL=
# Live mode is rejected unless all three values below are deliberately configured.
ENABLE_LIVE_PAYMENTS=false
PAYSTACK_LIVE_ACCOUNT_APPROVED=false
# Background processing. Disable here if running app.worker as a separate service.
RUN_BACKGROUND_WORKER=true
# Modes: dry_run, arkesel_sandbox, or arkesel_live.
SMS_MODE=dry_run
ARKESEL_API_KEY=
ENABLE_LIVE_SMS=false
ARKESEL_SENDER_ID_APPROVED=false
# Enable callback intake and add callback_url to sandbox submissions on HTTPS.
# Delivery state is reconciled through authenticated Arkesel message lookup.
ARKESEL_CALLBACKS_ENABLED=false
SMS_SENDER_ID=SikaLedger
# When false, previews must be queued explicitly in the UI.
AUTOMATIC_REMINDERS=false
REMINDER_START_HOUR=9
REMINDER_END_HOUR=18
